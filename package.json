{
  "name": "d3-geo",
  "version": "3.1.2",
  "description": "Shapes and calculators for spherical coordinates.",
  "homepage": "https://d3js.org/d3-geo/",
  "repository": {
    "type": "git",
    "url": "https://github.com/d3/d3-geo.git"
  },
  "keywords": [
    "d3",
    "d3-module",
    "geo",
    "maps",
    "cartography"
  ],
  "license": "ISC",
  "author": {
    "name": "Mike Bostock",
    "url": "https://bost.ocks.org/mike"
  },
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs"
  ],
  "module": "dist/d3-geo.mjs",
  "main": "dist/d3-geo.mjs",
  "jsdelivr": "dist/d3-geo.min.js",
  "unpkg": "dist/d3-geo.min.js",
  "exports": {
    "umd": "./dist/d3-geo.min.js",
    "default": "./dist/d3-geo.mjs"
  },
  "sideEffects": false,
  "dependencies": {
    "d3-array": "2.5.0 - 3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "canvas": "^3.2.3",
    "d3-format": "^3.1.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "rollup": "^4.67.4",
    "topojson-client": "^3.1.0",
    "vitest": "^5.1.0",
    "world-atlas": "^1.1.4"
  },
  "scripts": {
    "test": "vitest",
    "lint": "eslint",
    "prepublishOnly": "rm -rf dist && rollup -c"
  },
  "engines": {
    "node": ">=12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas"
    ]
  }
}
